.splash-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 底部压暗保证文字可读，顶部保留背景图细节 */
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.35) 50%, transparent 100%);
  z-index: 2;
}

.countdown {
  position: relative;
  z-index: 10;
  padding-top: 80rpx;
  padding-right: 32rpx;
  display: flex;
  justify-content: flex-end;
}

.countdown-box {
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10rpx);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s;
}

.countdown-box:active {
  background-color: rgba(0, 0, 0, 0.7);
  transform: scale(0.95);
}

.countdown-text {
  color: var(--brand-lightest);
  font-size: var(--fs-subtitle);
  font-weight: bold;
}

.countdown-suffix {
  color: var(--text-inverse);
  font-size: var(--fs-caption);
  margin-left: 8rpx;
}

.skip-icon {
  margin-left: 8rpx;
}

.content {
  position: relative;
  z-index: 10;
  padding: 0 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  height: 100vh;
  justify-content: flex-end;
  box-sizing: border-box;
}

.ad-tag {
  background-color: rgba(255, 255, 255, 0.2) !important;
  color: var(--text-inverse) !important;
  margin-bottom: 24rpx;
  align-self: flex-start;
}

.title {
  /* 开屏主标题：衬线大字是「古籍雅」的第一触点 */
  font-family: var(--font-serif);
  color: var(--text-inverse);
  font-size: var(--fs-hero);
  font-weight: bold;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  letter-spacing: 4rpx;
}

.desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--fs-body);
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.explore-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 24rpx 0;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
}

.brand-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--brand-gradient);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.brand-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--fs-body);
}