.edit-profile-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f9fafb;
}

.header {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  padding: 80rpx 32rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-icon {
  margin-right: 16rpx;
  width: 80rpx;
}

.header-title {
  color: white;
  font-size: 36rpx;
  font-weight: 500;
  flex: 1;
  text-align: center;
}

.header-placeholder {
  width: 80rpx;
}

.content {
  flex: 1;
  padding: 48rpx 32rpx;
}

.avatar-section {
  text-align: center;
  margin-bottom: 64rpx;
}

.avatar-wrapper {
  position: relative;
  display: inline-block;
  margin-bottom: 24rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  background-color: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #f97316, #fb923c);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.avatar-hint {
  font-size: 28rpx;
  color: #6b7280;
}

.form-section {
  background-color: white;
  border-radius: 32rpx;
  padding: 48rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.form-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #374151;
  margin-right: 32rpx;
  width: 120rpx;
}

.nickname-input {
  flex: 1;
}

.save-btn-section {
  padding-top: 16rpx;
}

.save-bottom-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
}

.tips-section {
  display: flex;
  align-items: center;
  background-color: #fef3c7;
  border-radius: 24rpx;
  padding: 32rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #92400e;
  margin-left: 16rpx;
  flex: 1;
}

.save-popup {
  background: transparent !important;
}

.save-popup-content {
  background-color: white;
  border-radius: 48rpx;
  padding: 80rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.save-popup-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.save-popup-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.save-popup-sub {
  font-size: 28rpx;
  color: #6b7280;
}
