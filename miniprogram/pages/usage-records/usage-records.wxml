<view class="usage-records-container">
  <view class="stats-header">
    <view class="stat-item">
      <text class="stat-value">{{totalRecords}}</text>
      <text class="stat-label">总使用次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalPaper}}</text>
      <text class="stat-label">累计节约纸张</text>
    </view>
  </view>

  <view class="records-list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="record-icon">
        <t-icon name="{{item.type === 'paper' ? 'file-text' : 'ticket'}}" size="48" color="#2e7d32"></t-icon>
      </view>
      <view class="record-content">
        <view class="record-title">{{item.title}}</view>
        <view class="record-desc">{{item.description}}</view>
        <view class="record-time">{{item.createTimeStr}}</view>
      </view>
      <view class="record-extra">
        <text class="record-amount" wx:if="{{item.amount}}">{{item.amount}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <t-empty description="暂无使用记录" />
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <t-loading theme="circular" size="40px" text="加载中..." />
  </view>
</view>
