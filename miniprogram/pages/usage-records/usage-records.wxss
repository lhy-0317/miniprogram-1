.usage-records-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 100%);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.records-list {
  padding: 0 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(46, 125, 50, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  margin-left: 20rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.record-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-extra {
  margin-left: 16rpx;
}

.record-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #2e7d32;
}

.empty-state {
  padding: 100rpx 0;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}
