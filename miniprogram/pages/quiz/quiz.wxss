.quiz-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--bg-page);
}

.header {
  /* 品牌色带用纯色，渐变只留给主按钮 */
  background: var(--brand);
  padding: 80rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.header-title {
  color: var(--text-inverse);
  font-size: var(--fs-title);
  font-weight: 500;
}

.content {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
}

.loading-text {
  font-size: var(--fs-body);
  color: var(--text-tertiary);
  margin-top: 24rpx;
}

.start-dialog {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.start-icon {
  width: 200rpx;
  height: 200rpx;
  background: var(--brand-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.start-icon-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.start-title {
  /* 古籍风衬线：PRD「雅」 */
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.start-desc {
  font-size: var(--fs-subtitle);
  color: var(--text-tertiary);
  margin-bottom: 32rpx;
}

.start-hint {
  font-size: var(--fs-body);
  color: var(--warning);
  margin-bottom: 64rpx;
  text-align: center;
}

.start-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.quiz-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stats-bar {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
  text-align: center;
}

.stats-text {
  font-size: var(--fs-subtitle);
  font-weight: 500;
  color: var(--text-secondary);
}

.question-card {
  position: relative;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.question-number {
  font-size: var(--fs-body);
  color: var(--text-tertiary);
  font-weight: 500;
}

.question-type {
  font-size: 22rpx;
  color: var(--brand);
  background: rgba(46, 125, 50, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.question-type.type-multi {
  color: #b45309;
  background: rgba(245, 158, 11, 0.12);
}

.multi-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}

.multi-hint text {
  font-size: 24rpx;
  color: #b45309;
}

/* 多选题选中未提交态 */
.option-item.picked {
  border-color: var(--brand);
  background-color: rgba(46, 125, 50, 0.06);
}

.option-circle.picked {
  border-color: var(--brand);
  background-color: var(--brand);
}

.question-text {
  /* 题干用衬线，呼应「本草纲目古籍风」的 PRD 定位 */
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.6;
}

/* ===== 答对烟花（纯 WXSS，无 Canvas 依赖） ===== */
.fireworks {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 20;
}

.fw-particle {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  opacity: 0;
  animation: fw-pop 0.9s ease-out forwards;
}

@keyframes fw-pop {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
  100% {
    transform: scale(0.4) translateY(-30rpx);
    opacity: 0;
  }
}

.result-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 64rpx 48rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--reward-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.result-score {
  font-size: var(--fs-subtitle);
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.restart-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  background-color: var(--bg-card);
  border: 3rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 32rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  position: relative;
  z-index: 10;
  pointer-events: auto;
}

.option-item:active {
  transform: scale(0.98);
  background-color: var(--bg-page);
}

/* 答对/答错用语义色，与品牌绿按钮明确区分 */
.option-item.correct {
  border-color: var(--success);
  background-color: var(--success-bg);
}

.option-item.wrong {
  border-color: var(--danger);
  background-color: var(--danger-bg);
}

.option-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--border-strong);
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-item.correct .option-circle {
  border-color: var(--success);
  background-color: var(--success);
}

.option-item.wrong .option-circle {
  border-color: var(--danger);
  background-color: var(--danger);
}

.option-text {
  flex: 1;
  font-size: var(--fs-subtitle);
  color: var(--text-secondary);
  line-height: 1.5;
}

.option-item.correct .option-text {
  color: var(--brand-ink);
  font-weight: 500;
}

.option-item.wrong .option-text {
  color: var(--danger-ink);
  font-weight: 500;
}

.option-icon {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.explanation-box {
  display: flex;
  align-items: center;
  background-color: var(--reward-bg);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-top: 32rpx;
}

.explanation-text {
  /* 解析是古籍小知识，衬线最贴切 */
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  color: var(--reward-ink);
  margin-left: 16rpx;
  flex: 1;
  line-height: 1.8;
}

.next-btn-container {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.next-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.coupon-popup {
  background: transparent !important;
}

.coupon-content {
  background-color: var(--bg-card);
  border-radius: 48rpx;
  padding: 80rpx 64rpx;
  width: 90%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.coupon-success-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--brand-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.coupon-title {
  font-size: var(--fs-display);
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.coupon-sub {
  font-size: var(--fs-body);
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

/* 券卡是激励时刻，保留金色渐变 */
.coupon-card {
  background: linear-gradient(to right, var(--reward-bg), #fed7aa);
  border: 4rpx dashed var(--reward);
  border-radius: var(--radius-md);
  padding: 32rpx;
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.coupon-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.coupon-amount {
  font-size: var(--fs-hero);
  font-weight: bold;
  color: var(--reward-deep);
  line-height: 1;
  margin-bottom: 8rpx;
}

.coupon-type {
  font-size: var(--fs-body);
  color: var(--text-secondary);
}

.coupon-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.coupon-expire-label {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.coupon-expire {
  font-size: var(--fs-small);
  color: var(--text-secondary);
  font-weight: 500;
}

.coupon-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 24rpx 0;
}

/* ===== 会话式答题：进度条与出题中提示 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stats-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stats-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.stats-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 本轮倒计时 */
.stats-timer {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(46, 125, 50, 0.08);
}

.stats-timer text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

/* 最后 30 秒高亮提醒 */
.stats-timer.warning {
  background: rgba(227, 77, 89, 0.1);
}

.stats-timer.warning text {
  color: #e34d59;
}

.stats-restart {
  font-size: 24rpx;
  color: var(--brand);
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--brand);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.question-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 60rpx 0;
}

/* ===== 本轮成绩卡 ===== */
.summary-popup {
  background: transparent !important;
}

.summary-card {
  width: 620rpx;
  background: white;
  border-radius: 40rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.summary-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.summary-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.summary-score {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 32rpx 0 24rpx;
}

.summary-score-num {
  font-size: 96rpx;
  font-weight: bold;
  color: var(--brand);
  line-height: 1;
}

.summary-score-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.summary-grid {
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--border);
  border-bottom: 2rpx solid var(--border);
}

.summary-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.cell-value {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.cell-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.summary-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 24rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: var(--radius-md);
  width: 100%;
  box-sizing: border-box;
}

.summary-tip text {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.5;
}

.summary-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 24rpx;
}

.summary-btn-ghost,
.summary-btn {
  flex: 1;
}
