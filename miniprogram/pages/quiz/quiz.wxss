.quiz-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f9fafb;
}

.header {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  padding: 80rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.header-title {
  color: white;
  font-size: 36rpx;
  font-weight: 500;
}

.content {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 24rpx;
}

.start-dialog {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.start-icon {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #f0fdf4, #bbf7d0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.start-icon-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.start-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.start-desc {
  font-size: 32rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}

.start-hint {
  font-size: 28rpx;
  color: #f59e0b;
  margin-bottom: 64rpx;
  text-align: center;
}

.start-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.quiz-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stats-bar {
  background-color: white;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  text-align: center;
}

.stats-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #374151;
}

.question-card {
  background-color: white;
  border-radius: 32rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.question-number {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.question-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1.5;
}

.result-card {
  background-color: white;
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #fef3c7, #fbbf24);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.result-score {
  font-size: 32rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

.restart-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  background-color: white;
  border: 3rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  position: relative;
  z-index: 10;
  pointer-events: auto;
}

.option-item:active {
  transform: scale(0.98);
  background-color: #f9fafb;
}

.option-item.correct {
  border-color: #22c55e;
  background-color: #f0fdf4;
}

.option-item.wrong {
  border-color: #ef4444;
  background-color: #fef2f2;
}

.option-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-item.correct .option-circle {
  border-color: #22c55e;
  background-color: #22c55e;
}

.option-item.wrong .option-circle {
  border-color: #ef4444;
  background-color: #ef4444;
}

.option-text {
  flex: 1;
  font-size: 32rpx;
  color: #374151;
  line-height: 1.5;
}

.option-item.correct .option-text {
  color: #16a34a;
  font-weight: 500;
}

.option-item.wrong .option-text {
  color: #dc2626;
  font-weight: 500;
}

.option-icon {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.explanation-box {
  display: flex;
  align-items: center;
  background-color: #fef3c7;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}

.explanation-text {
  font-size: 28rpx;
  color: #92400e;
  margin-left: 16rpx;
  flex: 1;
  line-height: 1.6;
}

.next-btn-container {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.next-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 64rpx;
}

.coupon-popup {
  background: transparent !important;
}

.coupon-content {
  background-color: white;
  border-radius: 48rpx;
  padding: 80rpx 64rpx;
  width: 90%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.coupon-success-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.coupon-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.coupon-sub {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

.coupon-card {
  background: linear-gradient(to right, #fef3c7, #fed7aa);
  border: 4rpx dashed #fbbf24;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.coupon-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.coupon-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #ea580c;
  line-height: 1;
  margin-bottom: 8rpx;
}

.coupon-type {
  font-size: 28rpx;
  color: #4b5563;
}

.coupon-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.coupon-expire-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.coupon-expire {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.coupon-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 50%, #81c784 100%);
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
}
