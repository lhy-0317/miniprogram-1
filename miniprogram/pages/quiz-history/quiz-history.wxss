.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-text {
  font-size: 26rpx;
  color: #999;
}

.history-question {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
}

.history-answer {
  margin-bottom: 24rpx;
}

.answer-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.answer-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.answer-text {
  font-size: 28rpx;
  color: #333;
}

.answer-text.wrong {
  color: #e34d59;
  text-decoration: line-through;
}

.answer-text.correct {
  color: #00a870;
}

.history-explanation {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.explanation-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.empty-container {
  padding-top: 200rpx;
}
