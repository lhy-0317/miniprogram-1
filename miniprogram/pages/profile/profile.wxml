<view class="profile-container">
  <view class="header" wx:if="{{isLoggedIn}}">
    <view class="decoration-circle circle-1"></view>
    <view class="decoration-circle circle-2"></view>
    
    <view class="header-content">
      <view class="user-info">
        <view class="avatar-wrapper" bind:tap="goToEditProfile">
          <view class="avatar">
            <t-image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" t-class="avatar-image" />
            <text wx:else>用</text>
          </view>
          <view class="edit-badge">
            <t-icon name="edit" size="24" color="white"></t-icon>
          </view>
        </view>
        <view class="user-detail" bind:tap="goToEditProfile">
          <view class="user-name-row">
            <text class="user-name">{{userInfo && userInfo.nickName || '微信用户'}}</text>
            <t-icon name="chevron-right" size="28" color="rgba(255,255,255,0.7)"></t-icon>
          </view>
          <text class="user-id">ID: {{userId}}</text>
        </view>
        <t-icon name="poweroff" size="40" color="white" class="settings-icon" bind:tap="handleLogout"></t-icon>
      </view>
      
      <view class="stats-grid">
        <view class="stat-card">
          <view class="stat-header">
            <t-icon name="file-text" size="32" color="rgba(255,255,255,0.7)"></t-icon>
            <text>已节约纸张</text>
          </view>
          <text class="stat-value">{{stats.savedPaper}}</text>
          <text class="stat-unit">张</text>
        </view>
        
        <view class="stat-card">
          <view class="stat-header">
            <t-icon name="check-circle-filled" size="32" color="rgba(255,255,255,0.7)"></t-icon>
            <text>累计答题</text>
          </view>
          <text class="stat-value">{{stats.quizCount}}</text>
          <text class="stat-unit">道</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <view class="login-card">
      <view class="login-logo">
        <view class="logo">
          <t-image src="/assets/icons/touxiang.png" t-class="logo-image"></t-image>
        </view>
        <text class="app-name">智惠本草</text>
        <text class="app-slogan">智慧环保 · 传承本草</text>
      </view>
      
      <view class="login-form">
        <view class="privacy-checkbox">
          <view class="checkbox {{agreedToPrivacy ? 'checked' : ''}}" bindtap="toggleAgreement">
            <t-icon wx:if="{{agreedToPrivacy}}" name="check" size="20" color="white"></t-icon>
          </view>
          <text class="checkbox-text">我已阅读并同意</text>
          <view class="login-link" bindtap="showUserAgreement">《用户协议》</view>
          <text class="checkbox-text">和</text>
          <view class="login-link" bindtap="showPrivacyPolicy">《隐私政策》</view>
        </view>

        <!-- 头像昵称填写（官方 open-type=chooseAvatar + type=nickname，二者独立选择） -->
        <view class="profile-fill">
          <button class="avatar-choose" open-type="chooseAvatar" bindchooseavatar="onChooseWxAvatar">
            <image wx:if="{{wxProfileAvatar}}" class="avatar-choose-img" src="{{wxProfileAvatar}}" mode="aspectFill"></image>
            <image wx:else class="avatar-choose-img" src="/assets/icons/touxiang.png" mode="aspectFill"></image>
            <view class="avatar-choose-badge">+</view>
          </button>
          <view class="nickname-fill">
            <text class="nickname-label">昵称</text>
            <input
              class="nickname-input"
              type="nickname"
              value="{{wxProfileNickname}}"
              placeholder="点击选择微信昵称"
              placeholder-class="nickname-placeholder"
              bindblur="onWxNicknameBlur"
            />
          </view>
        </view>

        <button class="login-btn {{!agreedToPrivacy ? 'disabled' : ''}}" bindtap="handleLogin" disabled="{{!agreedToPrivacy}}">
          <t-icon name="wechat" size="32" color="white"></t-icon>
          <text style="margin-left: 12rpx;">微信一键登录</text>
        </button>
      </view>
    </view>
  </view>
  
  <t-popup visible="{{showPrivacyPopup}}" placement="center" show-overlay t-class="privacy-popup">
    <view class="privacy-content">
      <view class="privacy-header">
        <text class="privacy-title">{{privacyTitle}}</text>
      </view>
      <scroll-view class="privacy-scroll" scroll-y>
        <view class="privacy-text">{{privacyContent}}</view>
      </scroll-view>
      <view class="privacy-footer">
        <t-button theme="default" size="large" t-class="privacy-btn" bindtap="closePrivacyPopup">关闭</t-button>
      </view>
    </view>
  </t-popup>
  
  <view class="content" wx:if="{{isLoggedIn}}">
    <view class="coupon-section">
      <view class="section-header">
        <text class="section-title">我的优惠券</text>
        <view class="filter-tabs">
          <view class="filter-tab {{filterType === 'all' ? 'active' : ''}}" bind:tap="setFilter" data-type="all">全部</view>
          <view class="filter-tab {{filterType === 'unused' ? 'active' : ''}}" bind:tap="setFilter" data-type="unused">未使用</view>
          <view class="filter-tab {{filterType === 'used' ? 'active' : ''}}" bind:tap="setFilter" data-type="used">已使用</view>
          <view class="filter-tab {{filterType === 'expired' ? 'active' : ''}}" bind:tap="setFilter" data-type="expired">已过期</view>
        </view>
      </view>
      
      <view class="coupon-list">
        <view wx:for="{{filteredCoupons}}" wx:key="id" class="coupon-item {{item.type === '领纸券' ? 'green' : (item.type === '购物券' ? 'purple' : (item.type === '优惠券' ? 'orange' : ''))}}">
          <view class="coupon-left">
            <view class="coupon-amount">{{item.amount}}</view>
            <view class="coupon-type">{{item.type}}</view>
            <view class="coupon-expire">有效期至 {{item.expireDate}}</view>
          </view>
          <view class="coupon-right">
            <t-button 
              theme="primary" 
              size="small" 
              t-class="use-btn" 
              disabled="{{item.status === 'expired' || item.status === 'used'}}"
              bindtap="useCoupon"
              data-id="{{item.id}}"
              data-status="{{item.status}}"
            >
              {{item.status === 'expired' ? '已过期' : (item.status === 'used' ? '已使用' : '立即使用')}}
            </t-button>
          </view>
        </view>
      </view>
    </view>
    
    <view class="menu-section">
      <t-cell-group>
        <t-cell title="订单记录" hover note-icon="chevron-right" bindtap="goToOrderRecords">
          <t-icon slot="left-icon" name="time" size="40" color="#1976d2"></t-icon>
        </t-cell>
        <t-cell title="答题历史" hover note-icon="chevron-right" bindtap="goToQuizHistory">
          <t-icon slot="left-icon" name="catalog" size="40" color="#7c3aed"></t-icon>
        </t-cell>
        <t-cell title="AR识别记录" hover note-icon="chevron-right" bindtap="goToArRecords">
          <t-icon slot="left-icon" name="user" size="40" color="#2e7d32"></t-icon>
        </t-cell>
        <t-cell title="设置" hover note-icon="chevron-right" bindtap="goToSettings">
          <t-icon slot="left-icon" name="setting" size="40" color="#ea580c"></t-icon>
        </t-cell>
        <t-cell title="帮助与反馈" hover note-icon="chevron-right" bindtap="goToFeedback">
          <t-icon slot="left-icon" name="help-circle" size="40" color="#6b7280"></t-icon>
        </t-cell>
      </t-cell-group>
    </view>
  </view>
</view>
