.profile-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--bg-page);
}

.header {
  position: relative;
  /* header 纯色品牌带；其上毛玻璃卡片与装饰圆维持层次 */
  background: var(--brand);
  padding: 80rpx 48rpx 80rpx;
  overflow: hidden;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.1);
}

.circle-1 {
  width: 320rpx;
  height: 320rpx;
  top: -160rpx;
  right: -80rpx;
}

.circle-2 {
  width: 256rpx;
  height: 256rpx;
  bottom: -128rpx;
  left: -80rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-wrapper {
  position: relative;
  margin-right: 32rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  background-color: white;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-elevated);
}

.avatar text {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--brand);
}

.edit-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #f97316, #fb923c);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
  box-shadow: var(--shadow-card);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

.user-id {
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
}

.settings-icon {
  margin-left: 32rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.stat-card {
  background-color: rgba(255,255,255,0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  padding: 32rpx;
}

.stat-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.stat-header text {
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
  margin-left: 12rpx;
}

.stat-value {
  display: block;
  color: white;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.stat-unit {
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
}

.content {
  flex: 1;
  margin-top: -32rpx;
  padding: 0 32rpx 32rpx;
  position: relative;
  z-index: 10;
}

.coupon-section {
  background-color: white;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.filter-tab {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 8rpx 20rpx;
  border-radius: 48rpx;
  transition: all 0.3s ease;
}

.filter-tab.active {
  color: var(--brand);
  font-weight: 500;
  background-color: #f0fdf4;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  background: linear-gradient(to right, #fef3c7, #fed7aa);
  border: 4rpx dashed #fbbf24;
  border-radius: 24rpx;
  padding: 32rpx;
  transition: all 0.3s ease;
}

.coupon-item.green {
  background: linear-gradient(to right, #f0fdf4, #ccfbf1);
  border-color: #86efac;
}

.coupon-item.purple {
  background: linear-gradient(to right, #f3e8ff, #e9d5ff);
  border-color: #c084fc;
}

/* 买2送1 等优惠券 */
.coupon-item.orange {
  background: linear-gradient(to right, #fff7ed, #fed7aa);
  border-color: #fdba74;
}

.coupon-item.orange .coupon-amount {
  color: #ea580c;
}

.coupon-item.orange .use-btn {
  background-color: #ea580c !important;
}

.coupon-item.green .coupon-amount {
  color: #16a34a;
}

.coupon-item.purple .coupon-amount {
  color: #7c3aed;
}

.coupon-item.purple .use-btn {
  background-color: #7c3aed !important;
}

.coupon-item:active {
  transform: scale(0.98);
}

.coupon-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.coupon-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #ea580c;
  line-height: 1;
  margin-bottom: 8rpx;
}

.coupon-type {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.coupon-expire {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.coupon-right {
  margin-left: 32rpx;
}

.use-btn {
  background-color: #f97316 !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  padding: 16rpx 24rpx !important;
}

.coupon-item.green .use-btn {
  background-color: #22c55e !important;
}

.menu-section {
  background-color: white;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.login-section {
  min-height: 100vh;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.login-card {
  background-color: white;
  border-radius: 48rpx;
  padding: 80rpx 64rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: var(--shadow-elevated);
}

.login-logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-logo .logo {
  width: 160rpx;
  height: 160rpx;
  background: var(--brand-gradient);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: var(--shadow-brand);
}

.logo-image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}

.login-logo .app-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.login-logo .app-slogan {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 头像昵称填写区（官方 chooseAvatar + nickname input，二者独立选择） */
.profile-fill {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 28rpx 32rpx;
  background: #f5f8f6;
  border-radius: 32rpx;
  gap: 32rpx;
}

.avatar-choose {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: var(--brand-gradient);
  flex-shrink: 0;
  line-height: normal;
  border: none;
}

.avatar-choose::after {
  border: none;
}

.avatar-choose-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}

.avatar-choose-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
  box-sizing: border-box;
  color: white;
  font-size: 32rpx;
  line-height: 36rpx;
  font-weight: bold;
}

.nickname-fill {
  flex: 1;
  min-width: 0;
}

.nickname-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  height: 64rpx;
  line-height: 64rpx;
  width: 100%;
}

.nickname-placeholder {
  font-size: 30rpx;
  font-weight: normal;
  color: var(--text-hint);
}

.login-form {
  text-align: center;
}

.login-btn {
  background: var(--brand-gradient) !important;
  border-radius: 32rpx !important;
  font-size: 36rpx !important;
  font-weight: bold !important;
  padding: 28rpx 0 !important;
  margin-bottom: 32rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12rpx !important;
  border: none !important;
  line-height: normal !important;
  color: white !important;
}

.login-btn::after {
  border: none !important;
}

.login-btn.disabled {
  background: #d1d5db !important;
  color: var(--text-hint) !important;
}

.privacy-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: var(--brand);
  border-color: var(--brand);
}

.checkbox-text {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.login-link {
  color: var(--brand-light);
  margin: 0 4rpx;
}

.privacy-popup {
  background: transparent !important;
}

.privacy-content {
  background-color: white;
  border-radius: 32rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.privacy-header {
  padding: 40rpx 40rpx 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  text-align: center;
}

.privacy-scroll {
  flex: 1;
  max-height: 60vh;
  overflow-y: auto;
  padding: 32rpx 40rpx;
}

.privacy-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

.privacy-footer {
  padding: 24rpx 40rpx 40rpx;
  border-top: 2rpx solid #f3f4f6;
}

.privacy-btn {
  width: 100%;
  border-radius: 24rpx !important;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}
