.ar-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #111827;
}

.camera-preview {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.camera-bg {
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.camera-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(17,24,39,0.8), rgba(17,24,39,0.3), rgba(17,24,39,0.8));
}

.top-bar {
  position: relative;
  z-index: 10;
  padding: 24rpx 32rpx;
  padding-top: 80rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-btn {
  background-color: rgba(0,0,0,0.5) !important;
  border-color: transparent !important;
  width: 80rpx;
  height: 80rpx;
  min-width: auto !important;
  padding: 0 !important;
}

.page-title {
  color: white;
  font-size: 36rpx;
  font-weight: 500;
}

.scan-state,
.result-state {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.scan-frame-container {
  position: relative;
  margin-bottom: 64rpx;
}

.pulse-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--brand-gradient);
  border-radius: 32rpx;
  animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.33);
    opacity: 1;
  }
  80%, 100% {
    transform: scale(1.2);
    opacity: 0;
  }
}

.scan-frame {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  border: 8rpx solid var(--digital-blue-bright);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.corner {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  border-color: var(--digital-blue-bright);
  border-width: 8rpx;
}

.corner.top-left {
  top: 0;
  left: 0;
  border-top-style: solid;
  border-left-style: solid;
  border-top-left-radius: 24rpx;
}

.corner.top-right {
  top: 0;
  right: 0;
  border-top-style: solid;
  border-right-style: solid;
  border-top-right-radius: 24rpx;
}

.corner.bottom-left {
  bottom: 0;
  left: 0;
  border-bottom-style: solid;
  border-left-style: solid;
  border-bottom-left-radius: 24rpx;
}

.corner.bottom-right {
  bottom: 0;
  right: 0;
  border-bottom-style: solid;
  border-right-style: solid;
  border-bottom-right-radius: 24rpx;
}

.scan-line {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  height: 8rpx;
  background: linear-gradient(to right, transparent, var(--digital-blue-bright), transparent);
  animation: scan 2s ease-in-out infinite;
}

@keyframes scan {
  0%, 100% {
    transform: translateY(-160rpx);
  }
  50% {
    transform: translateY(160rpx);
  }
}

.scan-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-hint text {
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.hint-card {
  background-color: rgba(0,0,0,0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  text-align: center;
}

.hint-title {
  display: block;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.hint-sub {
  display: block;
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
}

.model-container {
  position: relative;
  margin-bottom: 48rpx;
}

.model-box {
  width: 560rpx;
  height: 560rpx;
  background: linear-gradient(135deg, rgba(76,175,80,0.2), rgba(66,165,245,0.2));
  border-radius: 48rpx;
  border: 2rpx solid rgba(255,255,255,0.2);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-image {
  width: 384rpx;
  height: 384rpx;
  animation: rotate-hint 2s ease-in-out infinite;
}

@keyframes rotate-hint {
  0%, 100% {
    transform: rotate(-5deg);
  }
  50% {
    transform: rotate(5deg);
  }
}

.gesture-hint {
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: white;
  border-radius: 48rpx;
  padding: 12rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-elevated);
}

.gesture-hint text {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-left: 8rpx;
}

.herb-info-card {
  background-color: rgba(255,255,255,0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: var(--shadow-elevated);
}

.herb-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.herb-icon {
  width: 128rpx;
  height: 128rpx;
  background: var(--brand-gradient);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.herb-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.herb-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.herb-latin {
  font-size: 28rpx;
  color: var(--digital-blue);
  font-weight: 500;
}

.herb-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.herb-props {
  padding-top: 32rpx;
  border-top: 2rpx solid var(--bg-ghost);
  display: flex;
  justify-content: space-between;
}

.prop-item {
  display: flex;
  align-items: center;
}

.prop-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-right: 16rpx;
}

.bottom-bar {
  position: relative;
  z-index: 10;
  padding: 32rpx 0 64rpx;
  display: flex;
  justify-content: center;
  gap: 96rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-btn {
  width: 112rpx;
  height: 112rpx;
  background-color: rgba(255,255,255,0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.action-btn.primary {
  width: 128rpx;
  height: 128rpx;
  background: var(--brand-gradient);
  box-shadow: var(--shadow-brand);
}

.action-item text {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

.action-item:nth-child(2) text {
  color: white;
  font-weight: 500;
}
