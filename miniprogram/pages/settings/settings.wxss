.settings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.settings-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 32rpx 16rpx;
}

.account-section {
  padding: 48rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: white;
  border: 2rpx solid #dc2626;
  color: #dc2626;
  font-size: 30rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  background: #fef2f2;
}
