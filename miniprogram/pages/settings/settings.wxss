.settings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.settings-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 32rpx 16rpx;
}

.account-section {
  padding: 48rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: white;
  border: 2rpx solid #dc2626;
  color: #dc2626;
  font-size: 30rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  background: #fef2f2;
}

.privacy-content {
  width: 640rpx;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.privacy-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 2rpx solid #eee;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.privacy-scroll {
  flex: 1;
  max-height: 60vh;
  padding: 24rpx 32rpx;
}

.privacy-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.privacy-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #eee;
}

.privacy-btn {
  width: 100%;
}
