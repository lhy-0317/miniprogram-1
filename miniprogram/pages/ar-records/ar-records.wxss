.ar-records-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 100%);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.records-list {
  padding: 0 24rpx;
}

.record-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  width: 100%;
  height: 300rpx;
  background: #f0f0f0;
}

.record-image {
  width: 100%;
  height: 100%;
}

.placeholder-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-body {
  padding: 24rpx;
}

.herb-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.herb-info {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  padding: 100rpx 0;
}

.empty-action {
  margin-top: 32rpx;
}

.action-btn {
  background: linear-gradient(135deg, #2e7d32 0%, #4caf50 100%);
  color: white;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: none;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}
