.home-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 双色微渐变：本草绿雾 → 数智蓝雾，落实 PRD 双色系 */
  background: linear-gradient(to bottom, var(--brand-bg), var(--digital-blue-bg));
}

.header {
  /* header 为品牌色带，用纯色；渐变只留给主按钮 */
  background: var(--brand);
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  color: var(--text-inverse);
  font-size: var(--fs-title);
  font-weight: 500;
  margin-left: 12rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
}

.avatar text {
  color: var(--text-inverse);
  font-size: var(--fs-body);
  font-weight: 500;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

/* 品牌 slogan 仅保留这一处低调呈现 */
.content-slogan {
  font-size: var(--fs-small);
  color: var(--text-tertiary);
  letter-spacing: 8rpx;
  margin-bottom: 64rpx;
}

.scan-section {
  position: relative;
  margin-bottom: 64rpx;
}

.pulse-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.33);
    opacity: 1;
  }
  80%, 100% {
    transform: scale(1.2);
    opacity: 0;
  }
}

.scan-box {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 8rpx dashed var(--brand-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-elevated);
}

.scan-icon-box {
  width: 120rpx;
  height: 120rpx;
  background: var(--brand-gradient);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.scan-text {
  font-size: var(--fs-subtitle);
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.scan-sub {
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

.scan-btn {
  background: var(--brand-gradient);
  border-radius: var(--radius-lg);
  font-size: var(--fs-title);
  font-weight: bold;
  padding: 28rpx 0;
  margin-bottom: 48rpx;
  box-shadow: var(--shadow-brand);
}

.status-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.status-dot.online {
  background-color: var(--success);
  animation: pulse 1s ease-in-out infinite;
}

.status-dot.offline {
  background-color: var(--danger);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.status-text {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-secondary);
}

.loading-popup {
  background: transparent !important;
}

.loading-content {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 80rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  font-size: var(--fs-subtitle);
  font-weight: 500;
  color: var(--text-primary);
  margin-top: 32rpx;
  margin-bottom: 8rpx;
}

.loading-sub {
  font-size: var(--fs-small);
  color: var(--text-tertiary);
}

/* 领纸方式选择面板 */
.coupon-panel {
  background: var(--bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx env(safe-area-inset-bottom);
}

.coupon-panel-title {
  display: block;
  font-size: var(--fs-subtitle);
  font-weight: 500;
  color: var(--text-primary);
  text-align: center;
}

.coupon-panel-sub {
  display: block;
  font-size: var(--fs-small);
  color: var(--text-tertiary);
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.coupon-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}

.coupon-option-usable {
  background: var(--brand-bg);
  border: 2rpx solid var(--brand-border);
}

.coupon-option-free {
  background: var(--bg-ghost);
  border: 2rpx solid var(--border);
}

.coupon-option-left {
  display: flex;
  flex-direction: column;
}

.coupon-option-amount {
  font-size: var(--fs-subtitle);
  font-weight: 500;
  color: var(--brand);
}

.coupon-option-free .coupon-option-amount {
  color: var(--text-secondary);
}

.coupon-option-desc {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.coupon-option-right {
  display: flex;
  align-items: center;
}

.coupon-option-expiry {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-right: 8rpx;
}

.coupon-cancel {
  padding: 28rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--text-tertiary);
}