<view class="home-container">
  <view class="header">
    <view class="header-left">
      <t-icon name="check-circle-filled" size="40" color="white"></t-icon>
      <text class="header-title">智惠本草</text>
    </view>
    <view class="header-right">
      <t-icon name="notification" size="36" color="white"></t-icon>
      <view class="avatar">
        <text>用</text>
      </view>
    </view>
  </view>
  
  <view class="content">
    <text class="content-slogan">智慧环保 · 传承本草</text>

    <view class="scan-section">
      <view class="pulse-ring"></view>
      <view class="scan-box">
        <view class="scan-icon-box">
          <t-icon name="scan" size="64" color="white"></t-icon>
        </view>
        <text class="scan-text">扫描设备二维码</text>
        <text class="scan-sub">领取免费纸巾</text>
      </view>
    </view>
    
    <t-button theme="primary" size="large" block t-class="scan-btn" bind:tap="handleScan">
      点击扫码领纸
    </t-button>
    
    <view class="status-card">
      <view class="status-dot {{deviceStatus === 'online' ? 'online' : 'offline'}}"></view>
      <text class="status-text">{{statusText}}</text>
    </view>
  </view>
  
  <t-popup visible="{{loadingVisible}}" placement="center" show-overlay t-class="loading-popup">
    <view class="loading-content">
      <t-loading theme="circular" size="60" color="#4caf50"></t-loading>
      <text class="loading-text">指令已发送</text>
      <text class="loading-sub">等待设备出纸...</text>
    </view>
  </t-popup>

  <t-popup visible="{{showCouponPicker}}" placement="bottom" show-overlay t-class="coupon-popup">
    <view class="coupon-panel">
      <text class="coupon-panel-title">选择领纸方式</text>
      <text class="coupon-panel-sub">你有 {{availableCoupons.length}} 张可用券</text>

      <view class="coupon-option coupon-option-free" bind:tap="useCoupon" data-id="">
        <view class="coupon-option-left">
          <text class="coupon-option-amount">付费</text>
          <text class="coupon-option-desc">不使用优惠券</text>
        </view>
      </view>

      <view
        wx:for="{{availableCoupons}}"
        wx:key="id"
        class="coupon-option coupon-option-usable"
        bind:tap="useCoupon"
        data-id="{{item.id}}"
      >
        <view class="coupon-option-left">
          <text class="coupon-option-amount">{{item.amount}}</text>
          <text class="coupon-option-desc">{{item.desc}}</text>
        </view>
        <view class="coupon-option-right">
          <text class="coupon-option-expiry">有效期至 {{item.expireDate}}</text>
          <t-icon name="chevron-right" size="32" color="#2e7d32"></t-icon>
        </view>
      </view>

      <view class="coupon-cancel" bind:tap="closeCouponPicker">取消</view>
    </view>
  </t-popup>
</view>
